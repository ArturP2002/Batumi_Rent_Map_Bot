# Telegram
BOT_TOKEN=replace_me
WEBAPP_URL=https://your-domain.example/miniapp
# Comma-separated Telegram user IDs that get admin role on bootstrap
ADMIN_TELEGRAM_IDS=123456789

# Auth
INIT_DATA_MAX_AGE_SECONDS=86400
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_SECONDS=86400

# Database / Redis / S3 (overridden in docker-compose)
# Host ports avoid clashes with other local Docker Postgres/Redis (5432/6379)
DATABASE_URL=postgresql+asyncpg://batumi:batumi@localhost:5435/batumi_rent
REDIS_URL=redis://localhost:6380/0
S3_ENDPOINT=http://localhost:9010
S3_PUBLIC_URL=http://localhost:9010
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=batumi-photos
S3_REGION=us-east-1

# Geo
DEFAULT_CITY_LAT=41.6168
DEFAULT_CITY_LON=41.6367
TIMEZONE=Asia/Tbilisi

# Geocoding (Nominatim-compatible; set custom URL if needed)
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=BatumiRentMap/1.0

# Photos
MAX_PHOTOS_PER_PROPERTY=10
MAX_PHOTO_BYTES=5242880

# App
CORS_ORIGINS=*
DEBUG=true
